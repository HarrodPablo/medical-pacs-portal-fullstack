# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Server Configuration
PORT=3000
JWT_SECRET="your-jwt-secret-key"

# PACS Server (Orthanc)
ORTHANC_URL="http://your-pacs-server-ip:8042"
ORTHANC_USER="your_orthanc_username"
ORTHANC_PASS="your_orthanc_password"

# Email Service (Resend)
RESEND_API_KEY="re_sample_api_key"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Frontend Integration
FRONTEND_URL="https://your-frontend-domain.com"
NODE_ENV="production"
